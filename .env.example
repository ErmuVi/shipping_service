APP_TITLE=Shipping Service
ENVIRONMENT=development
DEBUG=true
PORT=8000

# Кука сессии живет год, чтобы посылки не терялись после закрытия браузера.
# В проде включите COOKIE_SECURE=true и работайте по HTTPS.
SESSION_COOKIE_MAX_AGE=31536000
COOKIE_SECURE=false

# CORS нужен только если фронтенд запускается на отдельном origin.
# Формат — JSON-список, например: CORS_ORIGINS=["http://localhost:5173"]
# CORS_ORIGINS=

# Внутри docker compose укажите DB_HOST=db и REDIS_HOST=redis / QDRANT_HOST=qdrant
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=secret_password
DB_NAME=shipping_db

REDIS_HOST=redis
REDIS_PORT=6379

QDRANT_HOST=qdrant
QDRANT_PORT=6333

# Ключ OpenRouter для ИИ-поддержки: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key
